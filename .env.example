POSTGRES_DB=bracket_craft
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
BRACKET_DB_PASSWORD=bracket_app_dev_password
# Compose derives DATABASE_URL from BRACKET_DB_PASSWORD when it is not set.
APP_ENV=development
JWT_SECRET=replace-this-development-secret-with-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_ISSUER=bracket-craft-api
JWT_AUDIENCE=bracket-craft-web
PLAYER_DATA_KEY=replace-this-development-player-key-with-at-least-32-characters
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
PLATFORM_ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUDIENCE=
CSRF_COOKIE_NAME=bc_csrf_token
CSRF_TOKEN_TTL_SECONDS=3600
MAX_REQUEST_BODY_BYTES=33554432
STORAGE_PROVIDER=s3
# Use MinIO locally or an S3-compatible endpoint. For GCS, use its XML API endpoint
# with interoperability (HMAC) credentials and STORAGE_PROVIDER=gcs.
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bracket-craft-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/bracket-craft-media
STORAGE_SIGNING_ENDPOINT_URL=
STORAGE_PRESIGN_SECONDS=300
STORAGE_MAX_IMAGE_BYTES=5242880
STORAGE_MAX_ARCHIVE_BYTES=26214400
STORAGE_MAX_ARCHIVE_FILES=200
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_SOCKET_BASE=http://localhost:8000
# Production SSR internal API URL; Compose overrides this to http://api:8000/api/v1.
NUXT_API_INTERNAL_BASE=http://api:8000/api/v1
